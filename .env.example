# Meli Desktop Companion — Enterprise AI Configuration
# Copy this file to .env and configure your production or cloud service credentials

# ============================================================
# Groq LLM API Settings (Required for AI responses)
# ============================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_CORE_MODEL_ID=openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# Speech-To-Text (STT) Settings
# ============================================================
# Default low-latency interaction: whisper-large-v3-turbo
# Accuracy-critical transcription: whisper-large-v3
GROQ_STT_TURBO_MODEL=whisper-large-v3-turbo
GROQ_STT_ACCURATE_MODEL=whisper-large-v3
GROQ_STT_MODEL=whisper-large-v3-turbo

# ============================================================
# Text-To-Speech (TTS) Settings
# ============================================================
# Provider evaluation: canopylabs/orpheus-v1-english
# Female voices: autumn (default - warm/companion), diana, hannah
# Fallback: Web Speech API (local/offline)
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn

# ============================================================
# PostgreSQL Settings (Authoritative Relational Persistence)
# Example: postgresql+asyncpg://postgres:password@localhost:5432/meli_db
# ============================================================
DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# ============================================================
# Elasticsearch Settings (Enterprise BM25 Knowledge Retrieval)
# Example: https://my-es-cluster.es.io:9200
# ============================================================
ELASTICSEARCH_URL=https://your-elasticsearch-endpoint:9200
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here
ELASTICSEARCH_INDEX=meli_enterprise_docs

# ============================================================
# Server Host Settings
# ============================================================
HOST=127.0.0.1
PORT=8000
